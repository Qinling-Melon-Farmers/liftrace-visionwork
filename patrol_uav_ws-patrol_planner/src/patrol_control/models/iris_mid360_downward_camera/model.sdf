<?xml version="1.0"?>
<sdf version="1.5">
  <!--
    来源：仓库根目录 iris_mid360_downward_camera.zip。
    PX4 启动时仍使用 vehicle:=iris_mid360，以匹配现有 PX4 autostart；
    本文件只覆盖 Gazebo 实际生成的机架。
  -->
  <model name="iris_mid360_downward_camera">
    <include>
      <uri>model://iris</uri>
    </include>

    <include>
      <uri>model://mid360</uri>
      <pose>0 0 0.08 0 0 0</pose>
    </include>
    <joint name="mid360_joint" type="fixed">
      <child>mid360::lidar_link</child>
      <parent>iris::base_link</parent>
    </joint>

    <!-- Simulation-only prop-guard contact envelope.  The bumper plugin emits
         actual Gazebo contact states; it does not arm, move, or actuate the
         vehicle.  Ground clearance keeps normal takeoff/landing off the
         obstacle-collision channel. -->
    <link name="competition_contact_link">
      <pose>0 0 0.13 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <collision name="competition_guard_collision">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <max_contacts>20</max_contacts>
      </collision>
      <sensor name="competition_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>competition_guard_collision</collision>
        </contact>
        <plugin name="competition_contact_ros"
                filename="libgazebo_ros_bumper.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>50</updateRate>
          <frameName>iris::base_link</frameName>
          <bumperTopicName>/mission/uav_contacts_raw</bumperTopicName>
        </plugin>
      </sensor>
    </link>
    <joint name="competition_contact_joint" type="fixed">
      <child>competition_contact_link</child>
      <parent>iris::base_link</parent>
    </joint>

    <!-- Gazebo 相机沿局部 +X 观察；绕 Y 轴 +90 度后光轴竖直向下。 -->
    <link name="downward_camera_link">
      <pose>0 0 -0.05 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>4.15e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.407e-6</iyy>
          <iyz>0</iyz>
          <izz>2.407e-6</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="downward_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="downward_camera_controller" filename="libgazebo_ros_camera.so">
          <robotNamespace>/</robotNamespace>
          <cameraName>downward_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <!-- 图像消息必须标记为光学 frame，不能误用物理 camera link。 -->
          <frameName>downward_camera_optical_frame</frameName>
          <alwaysOn>true</alwaysOn>
          <updateRate>30</updateRate>
        </plugin>
      </sensor>
    </link>
    <joint name="downward_camera_joint" type="fixed">
      <child>downward_camera_link</child>
      <parent>iris::base_link</parent>
    </joint>
  </model>
</sdf>
