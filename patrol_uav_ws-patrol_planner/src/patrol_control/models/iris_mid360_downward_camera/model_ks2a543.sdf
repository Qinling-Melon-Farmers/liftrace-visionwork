<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    Complete PX4/Gazebo vehicle used by the VCL06 full-chain Gate.
    The airframe, MID360, contact envelope and measured mounting transform are
    unchanged from model.sdf.  Camera intrinsics/distortion reproduce the
    KS2A543 baseline delivered by vision commit 6743099.
  -->
  <model name="iris_mid360_downward_camera">
    <include>
      <uri>model://iris</uri>
    </include>

    <include>
      <uri>model://mid360</uri>
      <pose>0 0 0.08 0 0 0</pose>
    </include>
    <joint name="mid360_joint" type="fixed">
      <child>mid360::lidar_link</child>
      <parent>iris::base_link</parent>
    </joint>

    <link name="competition_contact_link">
      <pose>0 0 0.20 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <collision name="competition_guard_collision">
        <geometry>
          <mesh>
            <uri>model://iris_mid360_downward_camera/meshes/competition_guard_ring.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <max_contacts>20</max_contacts>
      </collision>
      <sensor name="competition_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>competition_guard_collision</collision>
        </contact>
        <plugin name="competition_contact_ros"
                filename="libgazebo_ros_bumper.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>50</updateRate>
          <frameName>iris::base_link</frameName>
          <bumperTopicName>/mission/uav_contacts_raw</bumperTopicName>
        </plugin>
      </sensor>
    </link>
    <joint name="competition_contact_joint" type="fixed">
      <child>competition_contact_link</child>
      <parent>iris::base_link</parent>
    </joint>

    <!-- Preserve the measured body-to-camera mounting transform.  Gazebo
         camera sensors look along local +X; +90 degrees about Y points down. -->
    <link name="downward_camera_link">
      <pose>0 0 -0.05 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>4.15e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.407e-6</iyy>
          <iyz>0</iyz>
          <izz>2.407e-6</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="downward_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera name="color">
          <!-- 2*atan(1280/(2*fx)), fx=725.3510059644434 px. -->
          <horizontal_fov>1.44593453190313</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <distortion>
            <k1>0.0058668600963917095</k1>
            <k2>0.017910549546758369</k2>
            <p1>-0.0010064115869294274</p1>
            <p2>0.0014715593681005204</p2>
            <k3>-0.026485100937585344</k3>
            <center>0.4934936430758014 0.5521755296266148</center>
          </distortion>
        </camera>
        <plugin name="downward_camera_controller"
                filename="libgazebo_ros_camera.so">
          <robotNamespace>/</robotNamespace>
          <cameraName>downward_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>downward_camera_optical_frame</frameName>
          <alwaysOn>true</alwaysOn>
          <updateRate>30</updateRate>
          <CxPrime>631.67186313702575</CxPrime>
          <Cx>631.67186313702575</Cx>
          <Cy>397.56638133116269</Cy>
          <hackBaseline>0.0</hackBaseline>
          <focalLength>725.3510059644434</focalLength>
          <distortionK1>0.0058668600963917095</distortionK1>
          <distortionK2>0.017910549546758369</distortionK2>
          <distortionK3>-0.026485100937585344</distortionK3>
          <distortionT1>-0.0010064115869294274</distortionT1>
          <distortionT2>0.0014715593681005204</distortionT2>
          <autoDistortion>true</autoDistortion>
          <borderCrop>false</borderCrop>
        </plugin>
      </sensor>
    </link>
    <joint name="downward_camera_joint" type="fixed">
      <child>downward_camera_link</child>
      <parent>iris::base_link</parent>
    </joint>
  </model>
</sdf>
