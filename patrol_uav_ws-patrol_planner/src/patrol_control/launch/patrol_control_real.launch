<?xml version="1.0"?>
<launch> 
    <arg name="rviz" default="true" />
    <!-- 终端是否输出debug信息 -->
    <rosparam param="debug">true</rosparam>  
    <rosparam file="$(find patrol_control)/config/patrol_real.yaml" />
    <node pkg="patrol_control" type="patrol_control" name="patrol_control" output="screen">
        <remap from="/detect/waypoint_mark" to="/detect/waypoint_mark"/><!-- 后面字符串填上你的话题，消息类型：geometry_msgs::PoseStamped -->
        <remap from="/detect/land_mark" to="/detect/land_mark"/>        <!-- 后面字符串填上你的话题，消息类型：geometry_msgs::PoseStamped -->
    </node>

    <!-- 启动partol Planner launch文件 -->
    <include file="$(find plan_manage)/launch/patrol_planner_real.launch" />

    <!-- 启动rviz文件 -->
	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find patrol_control)/rviz_config/patrol_nano.rviz" />
	</group>
</launch>