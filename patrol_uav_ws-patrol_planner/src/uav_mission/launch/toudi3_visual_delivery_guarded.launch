<launch>
  <!-- Full laptop SITL with the unchanged legacy patrol flow behind a
       permission-gated, simulation-only mock release endpoint. -->
  <arg name="gui" default="true" />
  <arg name="rviz" default="false" />
  <arg name="start_mapping" default="true" />
  <arg name="start_arming" default="true" />
  <arg name="external_mission_mode" default="false" />
  <arg name="waypoint_mode" default="true" />
  <arg name="world" default="$(find patrol_control)/../../../toudi4_copy.world" />
  <arg name="waypoint_config"
       default="$(find patrol_control)/config/patrol_toudi4_new_vision.yaml" />
  <arg name="vision_python" default="$(optenv VISION_PYTHON /home/xhj/miniconda3/envs/rl_drone/bin/python)" />
  <arg name="camera_image_topic" default="/downward_camera/image_raw" />
  <arg name="camera_info_topic" default="/downward_camera/camera_info" />
  <arg name="target_model_path" default="$(optenv UAV_VISION_MODEL_PATH)" />
  <arg name="map_frame" default="camera_init" />
  <arg name="ground_z" default="0.0" />
  <arg name="allow_latest_tf_fallback" default="false" />
  <arg name="max_latest_tf_age_sec" default="0.10" />
  <arg name="drop_stable_frames" default="5" />
  <arg name="planner_max_vel" default="3.0" />
  <arg name="planner_max_acc" default="2.0" />
  <arg name="planner_obstacles_inflation" default="0.25" />
  <arg name="planner_clearance_threshold" default="0.20" />
  <arg name="px4_max_distance" default="0.2" />
  <arg name="enable_debug_image" default="false" />
  <!-- PX4 仍使用 iris_mid360 autostart，Gazebo 机架改用仓库内单下视相机模型。 -->
  <arg name="vehicle_sdf"
       default="$(find patrol_control)/models/iris_mid360_downward_camera/model.sdf" />
  <!-- Simulation calibration for body -> ROS optical frame.  The values are
       derived from the repository-local vehicle SDF.  A real aircraft must
       override these with its measured camera extrinsic. -->
  <arg name="camera_pose_topic" default="/mavros/local_position/pose" />
  <arg name="camera_parent_frame" default="vision_body" />
  <arg name="camera_optical_frame" default="downward_camera_optical_frame" />
  <arg name="camera_extrinsic_xyz" default="0 0 -0.05" />
  <arg name="camera_extrinsic_quat_xyzw" default="-0.70710678 0.70710678 0 0" />
  <arg name="audit_report_path"
       default="$(optenv SIM_RUN_DIR /tmp)/visual_delivery_audit.json" />

  <node pkg="tf2_ros" type="static_transform_publisher"
        name="downward_camera_extrinsic"
        args="$(arg camera_extrinsic_xyz) $(arg camera_extrinsic_quat_xyzw) $(arg camera_parent_frame) $(arg camera_optical_frame)" />

  <node pkg="uav_mission" type="pose_tf_broadcaster.py"
        name="vision_pose_tf" output="screen">
    <param name="pose_topic" value="$(arg camera_pose_topic)" />
    <param name="parent_frame" value="$(arg map_frame)" />
    <param name="child_frame" value="$(arg camera_parent_frame)" />
  </node>

  <include file="$(find patrol_control)/launch/toudi3_full_competition_sim_new_vision.launch">
    <arg name="world" value="$(arg world)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="start_mapping" value="$(arg start_mapping)" />
    <arg name="start_arming" value="$(arg start_arming)" />
    <arg name="external_mission_mode" value="$(arg external_mission_mode)" />
    <arg name="waypoint_mode" value="$(arg waypoint_mode)" />
    <arg name="vision_python" value="$(arg vision_python)" />
    <arg name="vehicle_sdf" value="$(arg vehicle_sdf)" />
    <arg name="waypoint_config" value="$(arg waypoint_config)" />
    <arg name="camera_image_topic" value="$(arg camera_image_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="target_model_path" value="$(arg target_model_path)" />
    <arg name="map_frame" value="$(arg map_frame)" />
    <arg name="ground_z" value="$(arg ground_z)" />
    <arg name="allow_latest_tf_fallback" value="$(arg allow_latest_tf_fallback)" />
    <arg name="max_latest_tf_age_sec" value="$(arg max_latest_tf_age_sec)" />
    <arg name="drop_stable_frames" value="$(arg drop_stable_frames)" />
    <arg name="planner_max_vel" value="$(arg planner_max_vel)" />
    <arg name="planner_max_acc" value="$(arg planner_max_acc)" />
    <arg name="planner_obstacles_inflation" value="$(arg planner_obstacles_inflation)" />
    <arg name="planner_clearance_threshold" value="$(arg planner_clearance_threshold)" />
    <arg name="px4_max_distance" value="$(arg px4_max_distance)" />
    <arg name="enable_debug_image" value="$(arg enable_debug_image)" />
  </include>

  <include file="$(find uav_mission)/launch/release_guard_sim.launch" />

  <node pkg="uav_mission" type="visual_delivery_audit.py"
        name="visual_delivery_audit" output="screen">
    <param name="report_path" value="$(arg audit_report_path)" />
  </node>
</launch>
