<launch>
  <arg name="gui" default="false" />
  <arg name="rviz" default="false" />
  <arg name="wall_timeout" default="3000.0" />
  <arg name="target_model_path" default="$(optenv UAV_VISION_MODEL_PATH)" />
  <arg name="manager_report_path"
       default="$(optenv SIM_RUN_DIR /tmp)/coverage_status.json" />
  <arg name="gate_report_path"
       default="$(optenv SIM_RUN_DIR /tmp)/gate_status.json" />
  <arg name="enable_debug_image" default="false" />
  <arg name="record_debug" default="false" />

  <include file="$(find uav_mission)/launch/toudi3_visual_delivery_guarded.launch">
    <arg name="gui" value="$(arg gui)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="enable_debug_image" value="$(arg enable_debug_image)" />
    <arg name="external_mission_mode" value="true" />
    <arg name="waypoint_mode" value="false" />
    <arg name="target_model_path" value="$(arg target_model_path)" />
    <arg name="planner_max_vel" value="1.5" />
    <arg name="planner_max_acc" value="1.0" />
    <arg name="planner_obstacles_inflation" value="0.30" />
    <arg name="planner_clearance_threshold" value="0.35" />
    <arg name="px4_max_distance" value="0.2" />
  </include>

  <node pkg="uav_mission" type="coverage_search_manager.py"
        name="coverage_search_manager" output="screen">
    <rosparam command="load"
              file="$(find uav_mission)/config/coverage_toudi4.yaml" />
    <param name="wall_timeout" value="$(arg wall_timeout)" />
    <param name="report_path" value="$(arg manager_report_path)" />
    <param name="gate_name" value="coverage_r6" />
    <param name="navigation_only" value="false" />
    <param name="execute_candidates" value="true" />
    <param name="collect_before_delivery" value="true" />
    <param name="final_land" value="true" />
    <param name="require_north" value="false" />
  </node>

  <node pkg="uav_mission" type="coverage_r6_assertion.py"
        name="coverage_r6_assertion" output="screen" required="true">
    <param name="wall_timeout" value="$(arg wall_timeout)" />
    <param name="report_path" value="$(arg gate_report_path)" />
  </node>

  <!-- 可选的 debug 视觉录制（默认关闭）：录制原始下视图像与各检测器 debug 图，
       供失败复盘（如 bridge 近地 circle 断链）。-->
  <node if="$(arg record_debug)" pkg="rosbag" type="record"
        name="debug_visual_recorder" output="screen"
        args="--lz4 --split --size=2048 --duration=610
              -o $(optenv SIM_RUN_DIR /tmp)/debug_visual
              /downward_camera/image_raw
              /uav_vision/circle_debug
              /uav_vision/landing_debug
              /uav_vision/cross_debug
              /uav_vision/debug_image" />
</launch>
