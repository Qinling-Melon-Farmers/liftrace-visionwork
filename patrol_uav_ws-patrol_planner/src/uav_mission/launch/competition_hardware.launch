<launch>
  <!-- Supervisor owns initialization ordering and the single application chain.
       Drivers/MAVROS/camera/physical raw actuator are started separately. -->
  <arg name="root" />
  <arg name="site_config" />
  <arg name="model_path" />
  <arg name="mode" default="preview" />
  <node pkg="uav_mission" type="competition_supervisor.py" name="competition_supervisor" output="screen" required="true"
        args="$(arg mode) --root $(arg root) --site-config $(arg site_config) --model $(arg model_path)" />
</launch>
