<launch>
  <!-- PX4/Gazebo SITL only. Legacy patrol_control performs all Servo calls. -->
  <arg name="gui" default="false" />
  <arg name="rviz" default="false" />
  <arg name="waypoint_config"
       default="$(find patrol_control)/config/patrol_toudi3_r1.yaml" />
  <arg name="world" default="$(find patrol_control)/../../toudi3.world" />
  <arg name="vehicle_sdf"
       default="$(optenv PX4_ROOT /home/xhj/PX4-Autopilot)/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models/iris_mid360/iris_mid360.sdf" />

  <include file="$(find patrol_control)/launch/patrol_full_competition_sim.launch">
    <arg name="world" value="$(arg world)" />
    <arg name="vehicle_sdf" value="$(arg vehicle_sdf)" />
    <arg name="spawn_x" value="0.0" />
    <arg name="spawn_y" value="0.0" />
    <arg name="spawn_z" value="0.06" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="mapping_rviz" value="false" />
    <arg name="start_mapping" value="false" />
    <arg name="start_visual" value="false" />
    <arg name="start_arming" value="true" />
    <arg name="waypoint_mode" value="true" />
    <arg name="simulation_auto_land" value="true" />
    <arg name="px4_max_distance" value="0.2" />
    <arg name="waypoint_config" value="$(arg waypoint_config)" />
  </include>

  <include file="$(find uav_mission)/launch/release_guard_sim.launch" />

  <node pkg="uav_mission" type="fixed_drop_evidence_mock.py"
        name="fixed_drop_evidence_mock" output="screen" />
  <node pkg="uav_mission" type="fixed_three_drop_assertion.py"
        name="fixed_three_drop_assertion" output="screen" required="true">
    <param name="wall_timeout" value="600.0" />
  </node>
</launch>
