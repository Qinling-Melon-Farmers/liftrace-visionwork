<launch>
  <!-- Stop the driver first. Mode 2 is SDK WakeUp, not Sleep or power-off. -->
  <arg name="lidar_ip" default="192.168.1.175" />
  <arg name="config" default="$(find livox_ros_driver2)/config/MID360_config.json" />
  <node pkg="uav_mission" type="mid360_power.py" name="mid360_standby" output="screen"
        args="wakeup --lidar-ip $(arg lidar_ip) --config $(arg config)" />
</launch>
