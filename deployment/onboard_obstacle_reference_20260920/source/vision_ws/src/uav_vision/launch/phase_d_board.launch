<launch>
  <!-- OrangePi/RK3588 完整视觉链。机器和相机相关内容全部通过 launch 参数传入，
       交付到其他工作区时不会继承开发笔记本路径。 -->
  <arg name="image_topic" default="/camera/image_raw" />
  <arg name="camera_info_topic" default="/camera/camera_info" />
  <arg name="model_path" default="" />
  <arg name="metadata_path"
       default="$(find uav_vision)/config/merged_standard_6cls_metadata.yaml" />
  <arg name="std_model_path" default="" />
  <arg name="std_metadata_path" default="" />
  <arg name="tank_model_path" default="" />
  <arg name="tank_metadata_path" default="" />
  <arg name="map_frame" default="camera_init" />
  <arg name="ground_z" default="0.0" />
  <arg name="allow_latest_tf_fallback" default="false" />
  <arg name="max_latest_tf_age_sec" default="0.10" />
  <arg name="rectify_input_pixels" default="true" />
  <arg name="default_align_mode" default="disabled" />
  <arg name="class_profile" default="full" />
  <arg name="require_alignment_context" default="false" />
  <arg name="alignment_context_topic"
       default="/uav_vision/alignment_target_context" />
  <arg name="release_evidence_context_topic"
       default="/uav_vision/release_evidence_context" />
  <arg name="enable_debug_image" default="false" />
  <!-- Typed board output is authoritative. Legacy wrappers must opt in explicitly. -->
  <arg name="start_legacy_compat" default="false" />

  <node pkg="uav_vision" type="target_detector_rknn.py"
        name="target_detector_rknn" output="screen" required="true">
    <rosparam file="$(find uav_vision)/config/default.yaml" />
    <rosparam file="$(find uav_vision)/config/target_detector_rknn.yaml" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="model_path" value="$(arg model_path)" />
    <param name="metadata_path" value="$(arg metadata_path)" />
    <param name="std_model_path" value="$(arg std_model_path)" />
    <param name="std_metadata_path" value="$(arg std_metadata_path)" />
    <param name="tank_model_path" value="$(arg tank_model_path)" />
    <param name="tank_metadata_path" value="$(arg tank_metadata_path)" />
  </node>

  <node pkg="uav_vision" type="cross_detector_node"
        name="cross_detector" output="screen">
    <rosparam file="$(find uav_vision)/config/default.yaml" />
    <rosparam file="$(find uav_vision)/config/cross_detector.yaml" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="enable_debug_image" value="$(arg enable_debug_image)" />
  </node>

  <node pkg="uav_vision" type="circle_detector_node"
        name="circle_detector" output="screen">
    <rosparam file="$(find uav_vision)/config/default.yaml" />
    <rosparam file="$(find uav_vision)/config/circle_detector.yaml" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="enable_debug_image" value="$(arg enable_debug_image)" />
    <param name="debug_image_topic" value="/uav_vision/circle_debug" />
  </node>

  <node pkg="uav_vision" type="landing_detector_node"
        name="landing_detector" output="screen">
    <rosparam file="$(find uav_vision)/config/default.yaml" />
    <rosparam file="$(find uav_vision)/config/landing_detector.yaml" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="default_align_mode" value="$(arg default_align_mode)" />
    <param name="enable_debug_image" value="$(arg enable_debug_image)" />
  </node>

  <node pkg="uav_vision" type="detection_fusion.py"
        name="detection_fusion" output="screen">
    <rosparam file="$(find uav_vision)/config/detection_fusion.yaml" />
    <param name="default_align_mode" value="$(arg default_align_mode)" />
    <!-- 正常帧在来源齐全时立即发布；该参数只负责缺失分支兜底，不代表端到端时延验收值。 -->
    <param name="flush_delay" value="0.80" />
  </node>

  <node pkg="uav_vision" type="target_refiner.py"
        name="target_refiner" output="screen">
    <rosparam file="$(find uav_vision)/config/target_refiner.yaml" />
    <param name="class_profile" value="$(arg class_profile)" />
  </node>

  <node pkg="uav_vision" type="target_map_projector.py"
        name="target_map_projector" output="screen">
    <rosparam file="$(find uav_vision)/config/default.yaml" />
    <rosparam file="$(find uav_vision)/config/target_map_projector.yaml" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="ground_z" value="$(arg ground_z)" />
    <param name="allow_latest_tf_fallback" value="$(arg allow_latest_tf_fallback)" />
    <param name="max_latest_tf_age_sec" value="$(arg max_latest_tf_age_sec)" />
    <param name="rectify_input_pixels" value="$(arg rectify_input_pixels)" />
  </node>

  <node pkg="uav_vision" type="target_memory.py"
        name="target_memory" output="screen">
    <rosparam file="$(find uav_vision)/config/target_memory.yaml" />
    <param name="detections_topic" value="/uav_vision/detections_mapped" />
    <param name="require_map_for_candidates" value="true" />
    <param name="require_complete_detection_sources" value="true" />
    <param name="default_align_mode" value="$(arg default_align_mode)" />
    <param name="class_profile" value="$(arg class_profile)" />
  </node>

  <node pkg="uav_vision" type="drop_aligner.py"
        name="drop_aligner" output="screen">
    <rosparam file="$(find uav_vision)/config/drop_aligner.yaml" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="class_profile" value="$(arg class_profile)" />
    <param name="require_alignment_context"
           value="$(arg require_alignment_context)" />
    <param name="alignment_context_topic"
           value="$(arg alignment_context_topic)" />
    <param name="release_evidence_context_topic"
           value="$(arg release_evidence_context_topic)" />
  </node>

  <group if="$(arg start_legacy_compat)">
    <node pkg="uav_vision" type="detect_compat_bridge.py"
          name="detect_compat_bridge" output="screen">
      <param name="detections_topic" value="/uav_vision/detections_mapped" />
    </node>
  </group>
</launch>
