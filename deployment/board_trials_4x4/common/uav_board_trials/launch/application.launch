<?xml version='1.0' encoding='utf-8'?>
<launch>
  <arg name="terminal_hover_enabled" default="false" />
  <arg name="max_command_z" default="$(eval float(arg('ground_z'))+2.9)" />
  <arg name="simulation" default="false" />
  <arg name="record_camera_video" default="$(arg simulation)" />
  <arg name="enable_control_output" default="false" />
  <arg name="cruise_speed" default="0.5" />
  <arg name="cruise_acceleration" default="0.35" />
  <arg name="mode" default="visual_interrupt" />
  <arg name="model_path" />
  <arg name="metadata_path" default="$(find uav_vision)/config/flight_5cls_20260928_metadata.yaml" />
  <arg name="generated_dir" />
  <arg name="ground_z" />
  <arg name="low_z" />
  <arg name="image_topic" default="/camera/image_raw" />
  <arg name="camera_info_topic" default="/camera/camera_info" />
  <arg name="actuator_mode" default="mock" />
  <arg name="raw_servo_service" default="/legacy/Servo_raw" />
  <arg name="map_frame" default="camera_init" />
  <include file="$(find uav_vision)/launch/phase_d_board.launch" unless="$(arg simulation)">
    <arg name="model_path" value="$(arg model_path)" />
    <arg name="metadata_path" value="$(arg metadata_path)" />
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="map_frame" value="$(arg map_frame)" />
    <arg name="ground_z" value="$(arg ground_z)" />
    <arg name="class_profile" value="r2026" />
    <arg name="require_alignment_context" value="true" />
    <arg name="start_legacy_compat" value="false" />
    <arg name="enable_debug_image" value="false" />
  </include>
  <include file="$(find uav_vision)/launch/phase_d.launch" if="$(arg simulation)">
    <arg name="target_model_path" value="$(arg model_path)" />
    <arg name="target_detector_launch_prefix" value="$(optenv VISION_PYTHON /home/xhj/miniconda3/envs/rl_drone/bin/python)" />
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="map_frame" value="$(arg map_frame)" />
    <arg name="ground_z" value="$(arg ground_z)" />
    <arg name="class_profile" value="r2026" />
    <arg name="require_alignment_context" value="true" />
    <arg name="start_legacy_compat" value="false" />
    <arg name="enable_debug_image" value="false" />
  </include>
  <group>
    <remap from="/Servo" to="/board_trials/Servo" />
    <remap from="/mavros/local_position/pose" to="/navigation/local_pose" />
    <remap from="/mavros/local_position/odom" to="/navigation/local_odom" />
    <remap from="/mavros/setpoint_position/local" to="$(eval '/board_trials/controller_setpoint' if arg('terminal_hover_enabled') else '/navigation/setpoint_mission')" />
    <include file="$(find patrol_control)/launch/patrol_control_px4_sim.launch" if="$(arg enable_control_output)">
      <arg name="rviz" value="false" />
      <arg name="waypoint_mode" value="false" />
      <arg name="external_mission_mode" value="true" />
      <arg name="simulation_auto_land" value="false" />
      <arg name="start_waypoint_generator" value="false" />
      <arg name="waypoint_config" value="$(arg generated_dir)/control.yaml" />
      <arg name="planner_max_vel" value="$(arg cruise_speed)" />
      <arg name="planner_max_acc" value="$(arg cruise_acceleration)" />
      <arg name="planner_obstacles_inflation" value="0.25" />
      <arg name="planner_clearance_threshold" value="0.025" />
      <arg name="px4_max_distance" value="0.25" />
      <arg name="external_planner_max_command_z" value="$(arg max_command_z)" />
    </include>
    <include file="$(find plan_manage)/launch/patrol_planner_px4_sim.launch" unless="$(arg enable_control_output)">
      <arg name="max_vel" value="$(arg cruise_speed)" />
      <arg name="max_acc" value="$(arg cruise_acceleration)" />
      <arg name="obstacles_inflation" value=".25" />
      <arg name="clearance_threshold" value=".025" />
      <arg name="start_waypoint_generator" value="false" />
      <arg name="map_size_x" value="10." />
      <arg name="map_size_y" value="6." />
      <arg name="map_size_z" value="3.8" />
    </include>
    <rosparam ns="/fast_planner_node" file="$(find uav_mission)/config/horizontal_planner.yaml" />
    <group ns="navigation">
      <node pkg="uav_board_trials" type="$(eval 'trial_sim_manager.py' if arg('simulation') else 'trial_manager.py')" name="mission_manager" output="screen" required="true">
        <rosparam file="$(arg generated_dir)/runtime.yaml" />
        <param name="profile/path" value="$(find uav_mission)/config/competition_profiles.yaml" />
        <remap from="candidates" to="/uav_vision/targets" />
        <remap from="pose" to="/navigation/local_pose" />
        <remap from="map" to="/freedom/static_pointcloud" />
        <remap from="mission_result" to="/navigation/mission_result" />
        <remap from="mission_command_raw" to="/navigation/mission_command_raw" />
        <remap from="mission_status" to="/navigation/mission_status" />
      </node>
    </group>
    <include file="$(find uav_mission)/launch/navigation_planner_bridge.launch">
      <arg name="execution_enabled" value="$(arg enable_control_output)" />
      <arg name="allow_live_goal_output" value="$(arg enable_control_output)" />
      <arg name="required" value="true" />
      <arg name="planner_goal_topic" value="/fastplanner/goal" />
      <arg name="planner_status_topic" value="/planning/goal_status" />
      <arg name="odom_topic" value="/navigation/local_odom" />
    </include>
  </group>
  <include file="$(find uav_mission)/launch/release_guard.launch" if="$(eval arg('enable_control_output') and arg('mode') not in ['landing','memory_only','high_speed_capture'])">
    <arg name="raw_service_name" value="$(eval '/board_trials/mock_servo' if arg('actuator_mode') == 'mock' else arg('raw_servo_service'))" />
    <arg name="require_evidence_context" value="true" />
    <arg name="class_profile" value="r2026" />
    <arg name="pose_topic" value="/navigation/local_pose" />
    <arg name="public_service_name" value="/board_trials/Servo" />
  </include>
  <node pkg="uav_board_trials" type="trial_auto_land.py" name="trial_auto_land" output="screen" required="true" if="$(eval arg('enable_control_output') and not arg('terminal_hover_enabled') and arg('mode') not in ['landing','high_view_full','high_speed_capture'])">
    <rosparam file="$(arg generated_dir)/auto_land.yaml" />
  </node>
  <node pkg="uav_board_trials" type="trial_terminal_hover.py" name="trial_terminal_hover" required="true" output="screen" if="$(eval arg('enable_control_output') and arg('terminal_hover_enabled'))">
    <rosparam file="$(arg generated_dir)/terminal_hover.yaml" />
  </node>
  <rosparam file="$(arg generated_dir)/overrides.yaml" />
  <node pkg="uav_board_trials" type="trial_journal.py" name="trial_journal" output="screen" unless="$(arg simulation)">
    <param name="directory" value="$(arg generated_dir)" />
  </node>
  <node pkg="uav_board_trials" type="trial_recorder.py" name="trial_recorder" output="screen" if="$(arg simulation)">
    <param name="video_enabled" value="$(arg record_camera_video)" />
    <param name="directory" value="$(arg generated_dir)" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="fps" value="5" />
    <param name="width" value="640" />
  </node>
  <node pkg="uav_board_trials" type="mock_servo.py" name="board_mock_servo" output="screen" required="true" if="$(eval arg('enable_control_output') and arg('actuator_mode') == 'mock' and arg('mode') not in ['landing','memory_only','high_speed_capture'])" />
</launch>
