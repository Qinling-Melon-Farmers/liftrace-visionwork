<launch>
  <!-- Loaded mechanisms: leave false. True is an explicit unloaded manual reset. -->
  <arg name="initialize_on_startup" default="false" />
  <!-- The permission proxy owns /Servo; the physical actuator is its raw backend. -->
  <node name="servo_controller1" pkg="actuator_pwm" type="pwm_node1" output="screen">
    <param name="initialize_on_startup" type="bool" value="$(arg initialize_on_startup)" />
    <remap from="Servo" to="/legacy/Servo_raw" />
  </node>
</launch>
