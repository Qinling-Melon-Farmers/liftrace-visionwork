<?xml version="1.0"?>
<model>
  <name>iris + MID360 + 下视相机</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>

  <author>
    <name>liftrace 仿真集成</name>
  </author>

  <description>
    由 iris_mid360_downward_camera.zip 提取的仿真机架，包含 Iris、MID360
    和单个 640x480 下视 RGB 相机。相机消息使用 ROS 光学坐标系。
  </description>
</model>
