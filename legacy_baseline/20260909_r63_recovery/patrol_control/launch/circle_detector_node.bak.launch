<?xml version="1.0"?>
<launch>
  <!-- 定义参数 -->
  <arg name="debug" default="false" />
  
  <!-- 加载检测参数 -->
  <rosparam command="load" file="$(find patrol_control)/config/circle_detection_params.yaml" />
  
  <!-- 圆形检测节点 -->
  <node name="circle_detector_node" pkg="patrol_control" type="circle_detector_node" output="screen">
    <!-- 重映射话题 -->
    <remap from="/iris_mid360/camera/rgb/image_raw" to="/iris_mid360/camera/rgb/image_raw" />
    <remap from="/mavros/local_position/pose" to="/mavros/local_position/pose" />
    <remap from="/detect/waypoint_mark" to="/detect/waypoint_mark" />
    <remap from="/detect/status" to="/detect/status" />
  </node>

  <!-- 可选：图像查看器（调试用） -->
  <group if="$(arg debug)">
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
      <remap from="image" to="/iris_mid360/camera/rgb/image_raw" />
      <param name="autosize" value="true" />
    </node>
  </group>

  <!-- 可选：检测结果可视化 -->
  <group if="$(arg debug)">
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find patrol_control)/rviz_config/patrol_pc.rviz" />
  </group>
</launch> 