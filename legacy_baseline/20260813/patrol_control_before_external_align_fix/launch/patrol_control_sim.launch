<?xml version="1.0"?>
<launch>
    <arg name="rviz" default="true" />

    <!-- 终端是否输出debug信息 -->
    <rosparam param="debug">true</rosparam>
    <rosparam file="$(find patrol_control)/config/patrol_sim.yaml" />

    <!-- Odom → Pose relay: 内部仿真器发布的是 Odometry 类型 (/state_ukf/odom)，
         但 patrol_control 需要 PoseStamped 类型 (/mavros/local_position/pose) -->
    <node pkg="patrol_control" type="odom_to_pose_relay.py" name="odom_to_pose_relay" output="screen">
        <param name="in_topic" value="/state_ukf/odom" />
        <param name="out_topic" value="/mavros/local_position/pose" />
    </node>

    <node pkg="patrol_control" type="patrol_control" name="patrol_control" output="screen">
        <!-- alignment_control 节点订阅 /mavros/local_position/odom，内部仿真中重定向到 /state_ukf/odom -->
        <remap from="/mavros/local_position/odom" to="/state_ukf/odom"/>
        <remap from="/detect/waypoint_mark" to="/detect/waypoint_mark"/>
        <remap from="/detect/land_mark" to="/detect/land_mark"/>
    </node>

    <!-- 启动partol Planner launch文件 -->
    <include file="$(find plan_manage)/launch/patrol_planner_sim.launch" />

    <!-- 启动 rviz 文件 -->
    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find patrol_control)/rviz_config/patrol_pc.rviz" />
    </group>
</launch>
