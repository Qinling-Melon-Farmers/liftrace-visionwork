# Fenced companion to unchanged Servo.srv. request_id is controller-local,
# not mission decision_seq. Proxy validates ALL fixed identity fields before raw.
uint64 request_id
uint8 payload_slot
string mission_id
uint32 decision_seq
uint16 attempt
uint32 target_id
time target_first_seen
string target_class
string align_mode
---
uint8 EXECUTION_UNKNOWN=0
uint8 NOT_STARTED=1
uint8 RAW_CALL_STARTED=2
uint8 COMPLETED=3
uint64 request_id
uint8 payload_slot
bool res
uint8 execution_state
bool terminal
string reason
