<launch>
  <!-- 主动 A/B：baseline 走原 12 点覆盖；guided 允许蓝环粗发现后裁剪覆盖。 -->
  <arg name="strategy" default="baseline" />
  <arg name="enable_aux" default="false" />
  <arg name="gui" default="false" />
  <arg name="rviz" default="false" />
  <arg name="start_arming" default="false" />
  <arg name="start_mapping" default="true" />
  <arg name="wall_timeout" default="1200.0" />
  <arg name="aux_angle_deg" default="55" />
  <arg name="aux_trigger_count" default="5" />
  <arg name="aux_min_approach_count" default="2" />
  <arg name="handoff_match_distance_m" default="1.0" />
  <arg name="handoff_max_age_sec" default="0.75" />
  <arg name="vehicle_sdf" />
  <arg name="target_model_path" default="$(optenv UAV_VISION_MODEL_PATH)" />
  <arg name="report_path"
       default="$(optenv SIM_RUN_DIR /tmp)/gate_status.json" />

  <include file="$(find uav_mission)/launch/toudi3_visual_delivery_guarded.launch">
    <arg name="gui" value="$(arg gui)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="start_arming" value="$(arg start_arming)" />
    <arg name="start_mapping" value="$(arg start_mapping)" />
    <arg name="external_mission_mode" value="true" />
    <arg name="waypoint_mode" value="false" />
    <arg name="vehicle_sdf" value="$(arg vehicle_sdf)" />
    <arg name="target_model_path" value="$(arg target_model_path)" />
  </include>

  <group if="$(arg enable_aux)">
    <node pkg="uav_vision_eval" type="aux_camera_extrinsic_tf.py"
          name="aux_camera_extrinsic_tf" output="screen">
      <param name="parent_frame" value="vision_body" />
      <param name="child_frame" value="aux_camera_optical_frame" />
      <rosparam param="xyz">[0.12, 0.0, 0.0]</rosparam>
      <param name="depression_angle_deg" value="$(arg aux_angle_deg)" />
    </node>

    <include file="$(find uav_vision_eval)/launch/oblique_aux_blue_chain.launch">
      <arg name="image_topic" value="/aux_camera/image_raw" />
      <arg name="camera_info_topic" value="/aux_camera/camera_info" />
      <arg name="map_frame" value="camera_init" />
      <arg name="ground_z" value="0.0" />
      <arg name="processing_rate_hz" value="10.0" />
    </include>
  </group>

  <!-- 评测外挂独占 /fastplanner/goal；不启动旧 coverage_search_manager。 -->
  <node pkg="uav_vision_eval" type="aux_guided_search_manager.py"
        name="aux_guided_search_manager" output="screen" required="true">
    <rosparam command="load"
              file="$(find uav_mission)/config/coverage_toudi4.yaml" />
    <param name="strategy" value="$(arg strategy)" />
    <param name="coverage/dwell_time" value="0.0" />
    <param name="wall_timeout" value="$(arg wall_timeout)" />
    <param name="report_path" value="$(arg report_path)" />
    <param name="required_target_count" value="5" />
    <rosparam param="guided/sparse_row_indices">[2, 5]</rosparam>
    <param name="guided/aux_trigger_count" value="$(arg aux_trigger_count)" />
    <param name="guided/aux_min_approach_count"
           value="$(arg aux_min_approach_count)" />
    <param name="guided/downward_verify_dwell_sec" value="2.0" />
    <!-- 交接只接受当前粗候选附近、且复核阶段新产生的下视确认。 -->
    <param name="guided/handoff_match_distance_m"
           value="$(arg handoff_match_distance_m)" />
    <param name="guided/handoff_max_age_sec"
           value="$(arg handoff_max_age_sec)" />
    <param name="guided/handoff_preverify_grace_sec" value="0.20" />
  </node>
</launch>
