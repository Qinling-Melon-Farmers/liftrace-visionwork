<launch>
  <arg name="catalog_file"
       default="$(find uav_vision_eval)/config/sim_target_catalog_toudi4.yaml" />
  <arg name="scenario_file" default="$(find uav_vision_eval)/config/scenarios/existing_targets.yaml" />
  <arg name="image_topic" default="/camera/color/image_raw" />
  <arg name="camera_info_topic" default="/camera/color/camera_info" />
  <arg name="link_states_topic" default="/gazebo/link_states" />
  <arg name="model_states_topic" default="/gazebo/model_states" />
  <arg name="truth_topic" default="/uav_vision_eval/ground_truth" />
  <arg name="world_frame" default="world" />
  <arg name="camera_link_suffix" default="D435i::camera_color_frame" />
  <arg name="broadcast_camera_tf" default="true" />
  <arg name="camera_pose_is_optical" default="false" />
  <!-- LinkStates has no Header. Stamp it once, then make TF and truth select
       the same zero-order-held pose for each image timestamp. -->
  <arg name="use_stamped_camera_pose" default="true" />
  <arg name="camera_pose_topic" default="/uav_vision_eval/camera_pose" />
  <!-- Re-broadcast the exact frames consumed by the coarse detector. Raw
       image and detector queue_size=1 subscribers may drop different stamps. -->
  <arg name="tf_detection_trigger_topic" default="/uav_vision/detections" />
  <arg name="tf_detection_trigger_source" default="target_detector" />
  <!-- 0 preserves the unthrottled historical behavior. Long-running evals
       may cap this latest-state stream above their image/route rates. -->
  <arg name="camera_pose_publish_rate_hz" default="0.0" />

  <node if="$(arg use_stamped_camera_pose)" pkg="uav_vision_eval"
        type="gazebo_camera_pose_stamper.py"
        name="gazebo_camera_pose_stamper" output="screen">
    <param name="world_frame" value="$(arg world_frame)" />
    <param name="camera_link_suffix" value="$(arg camera_link_suffix)" />
    <param name="link_states_topic" value="$(arg link_states_topic)" />
    <param name="output_topic" value="$(arg camera_pose_topic)" />
    <param name="max_publish_rate_hz"
           value="$(arg camera_pose_publish_rate_hz)" />
  </node>

  <node pkg="uav_vision_eval" type="sim_ground_truth_projector.py"
        name="sim_ground_truth_projector" output="screen">
    <param name="catalog_file" value="$(arg catalog_file)" />
    <param name="scenario_file" value="$(arg scenario_file)" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="link_states_topic" value="$(arg link_states_topic)" />
    <param name="model_states_topic" value="$(arg model_states_topic)" />
    <param name="output_topic" value="$(arg truth_topic)" />
    <param name="camera_link_suffix" value="$(arg camera_link_suffix)" />
    <param name="allow_fallback_pose" value="false" />
    <param name="camera_pose_is_optical" value="$(arg camera_pose_is_optical)" />
    <param name="use_stamped_camera_pose" value="$(arg use_stamped_camera_pose)" />
    <param name="camera_pose_topic" value="$(arg camera_pose_topic)" />
  </node>

  <node if="$(arg broadcast_camera_tf)" pkg="uav_vision_eval" type="gazebo_camera_tf.py"
        name="gazebo_camera_tf" output="screen">
    <param name="world_frame" value="$(arg world_frame)" />
    <param name="camera_link_suffix" value="$(arg camera_link_suffix)" />
    <param name="link_states_topic" value="$(arg link_states_topic)" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="camera_pose_is_optical" value="$(arg camera_pose_is_optical)" />
    <param name="use_stamped_camera_pose" value="$(arg use_stamped_camera_pose)" />
    <param name="camera_pose_topic" value="$(arg camera_pose_topic)" />
    <param name="detection_trigger_topic"
           value="$(arg tf_detection_trigger_topic)" />
    <param name="detection_trigger_source"
           value="$(arg tf_detection_trigger_source)" />
  </node>
</launch>
