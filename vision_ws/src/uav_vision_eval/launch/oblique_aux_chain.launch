<launch>
  <!-- 独立辅助视觉链；绝不包含 refiner/drop_aligner/兼容桥或控制节点。 -->
  <arg name="image_topic" default="/aux_camera/image_raw" />
  <arg name="camera_info_topic" default="/aux_camera/camera_info" />
  <arg name="depth_topic" default="/aux_camera/depth/image_raw" />
  <arg name="projection_mode" default="mono" />
  <arg name="map_frame" default="camera_init" />
  <arg name="ground_z" default="0.0" />
  <arg name="vision_python"
       default="$(optenv VISION_PYTHON /home/xhj/miniconda3/envs/rl_drone/bin/python)" />
  <arg name="target_model_path" default="$(optenv UAV_VISION_MODEL_PATH)" />
  <arg name="allow_latest_tf_fallback" default="false" />
  <arg name="max_latest_tf_age_sec" default="0.10" />
  <arg name="inference_rate_hz" default="5.0" />

  <!-- 仿真辅助链按搜索阶段目标频率节流，避免把 20 Hz 第二路 PyTorch 常开
       误当成板端调度方案；下视生产链不受影响。 -->
  <node pkg="topic_tools" type="throttle" name="aux_image_throttle"
        args="messages $(arg image_topic) $(arg inference_rate_hz) /uav_vision/aux/image_throttled"
        output="screen" />

  <group>
    <remap from="/uav_vision/detections" to="/uav_vision/aux/detections" />
    <remap from="/uav_vision/perf" to="/uav_vision/aux/perf" />

    <node pkg="uav_vision" type="target_detector.py"
          name="aux_target_detector" output="screen"
          launch-prefix="$(arg vision_python)">
      <rosparam file="$(find uav_vision)/config/target_detector.yaml" />
      <param name="image_topic" value="/uav_vision/aux/image_throttled" />
      <param name="model_path" value="$(arg target_model_path)" />
      <param name="perf_topic" value="/uav_vision/aux/perf" />
    </node>
  </group>

  <node pkg="uav_vision_eval" type="aux_coarse_projector.py"
        name="aux_coarse_projector" output="screen">
    <rosparam file="$(find uav_vision_eval)/config/oblique_camera_feasibility.yaml" />
    <param name="input_topic" value="/uav_vision/aux/detections" />
    <param name="output_topic" value="/uav_vision/aux/detections_mapped" />
    <param name="diagnostics_topic" value="/uav_vision/aux/projection_diagnostics" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="projection_mode" value="$(arg projection_mode)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="ground_z" value="$(arg ground_z)" />
    <param name="allow_latest_tf_fallback" value="$(arg allow_latest_tf_fallback)" />
    <param name="max_latest_tf_age_sec" value="$(arg max_latest_tf_age_sec)" />
  </node>

  <node pkg="uav_vision_eval" type="aux_candidate_memory.py"
        name="aux_candidate_memory" output="screen">
    <rosparam file="$(find uav_vision_eval)/config/oblique_camera_feasibility.yaml" />
    <param name="input_topic" value="/uav_vision/aux/detections_mapped" />
    <param name="output_topic" value="/uav_vision/aux/targets" />
    <param name="reset_service" value="/uav_vision/aux/reset_memory" />
  </node>
</launch>
