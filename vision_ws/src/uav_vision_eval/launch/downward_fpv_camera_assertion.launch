<launch>
  <arg name="px4_root" default="/home/xhj/PX4-Autopilot" />
  <arg name="px4_model_root"
       default="$(arg px4_root)/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models" />
  <arg name="image_topic" default="/downward_fpv_test/usb_cam/image_raw" />
  <arg name="camera_info_topic"
       default="/downward_fpv_test/usb_cam/camera_info" />
  <arg name="output_file" default="/tmp/downward_fpv_camera.png" />

  <include file="$(find patrol_control)/launch/patrol_world.launch">
    <arg name="start_px4" value="false" />
    <arg name="gui" value="false" />
    <arg name="sdf"
         value="$(find uav_vision_eval)/models/downward_fpv_test/model.sdf" />
    <arg name="gazebo_model_path"
         value="$(find uav_vision_eval)/models:$(arg px4_model_root)" />
    <arg name="vehicle" value="downward_fpv_test" />
    <arg name="x" value="-0.57481" />
    <arg name="y" value="0.520346" />
    <arg name="z" value="1.5" />
  </include>

  <include file="$(find uav_vision_eval)/launch/ground_truth.launch">
    <arg name="catalog_file"
         value="$(find uav_vision_eval)/config/sim_target_catalog_toudi4.yaml" />
    <arg name="scenario_file"
         value="$(find uav_vision_eval)/config/scenarios/existing_targets.yaml" />
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="camera_link_suffix" value="fpv_cam::link" />
    <arg name="truth_topic" value="/uav_vision_eval/downward_fpv_truth" />
    <arg name="broadcast_camera_tf" value="false" />
  </include>

  <node pkg="uav_vision_eval" type="image_snapshot.py"
        name="downward_fpv_snapshot" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="output_file" value="$(arg output_file)" />
  </node>

  <node pkg="uav_vision_eval" type="gazebo_truth_assertion.py"
        name="downward_fpv_truth_assertion" output="screen" required="true">
    <param name="truth_topic" value="/uav_vision_eval/downward_fpv_truth" />
    <param name="expected_target_id" value="pillbox_1" />
    <param name="require_fully_in_frame" value="true" />
    <param name="min_messages" value="5" />
    <param name="timeout_sec" value="20.0" />
  </node>
</launch>
