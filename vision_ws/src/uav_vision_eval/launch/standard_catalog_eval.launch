<launch>
  <!-- Parameterized top-down view for each standard target already in toudi3. -->
  <arg name="target_id" default="tent_1" />
  <arg name="camera_x" default="1.01558" />
  <arg name="camera_y" default="0.25625" />
  <arg name="camera_z" default="1.5" />
  <arg name="camera_yaw" default="0.0" />
  <arg name="evaluation_seed" default="-1" />
  <arg name="gui" default="false" />
  <arg name="start_vision" default="false" />
  <arg name="run_truth_assertion" default="false" />
  <arg name="record_metrics" default="false" />
  <arg name="output_dir" default="/tmp/uav_vision_eval/standard_catalog" />
  <arg name="gate_profile" default="smoke" />

  <include file="$(find uav_vision_eval)/launch/toudi3_static_eval.launch">
    <arg name="scenario_file"
         value="$(find uav_vision_eval)/config/scenarios/existing_targets.yaml" />
    <arg name="camera_x" value="$(arg camera_x)" />
    <arg name="camera_y" value="$(arg camera_y)" />
    <arg name="camera_z" value="$(arg camera_z)" />
    <arg name="camera_yaw" value="$(arg camera_yaw)" />
    <arg name="evaluation_seed" value="$(arg evaluation_seed)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="start_vision" value="$(arg start_vision)" />
    <arg name="run_truth_assertion" value="$(arg run_truth_assertion)" />
    <arg name="expected_target_id" value="$(arg target_id)" />
    <arg name="record_metrics" value="$(arg record_metrics)" />
    <arg name="output_dir" value="$(arg output_dir)" />
    <arg name="gate_profile" value="$(arg gate_profile)" />
    <arg name="require_geometry_verified_detections" value="true" />
  </include>
</launch>
