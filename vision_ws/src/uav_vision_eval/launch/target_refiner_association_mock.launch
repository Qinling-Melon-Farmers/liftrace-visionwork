<launch>
  <node pkg="uav_vision" type="target_refiner.py" name="target_refiner_r2026" output="screen">
    <rosparam file="$(find uav_vision)/config/target_refiner.yaml" />
    <param name="input_topic" value="/association_test/r2026/input" />
    <param name="output_topic" value="/association_test/r2026/output" />
    <param name="class_profile" value="r2026" />
  </node>
  <node pkg="uav_vision" type="target_refiner.py" name="target_refiner_full" output="screen">
    <rosparam file="$(find uav_vision)/config/target_refiner.yaml" />
    <param name="input_topic" value="/association_test/full/input" />
    <param name="output_topic" value="/association_test/full/output" />
    <param name="class_profile" value="full" />
  </node>
  <node pkg="uav_vision_eval" type="target_refiner_association_assertion.py"
        name="target_refiner_association_assertion" output="screen" required="true" />
</launch>
