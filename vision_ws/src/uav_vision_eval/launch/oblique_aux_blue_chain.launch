<launch>
  <!-- 斜下粗搜索的轻量路径：只判断“这里有标准蓝环靶”，不判断中心图案类别。 -->
  <arg name="image_topic" default="/aux_camera/image_raw" />
  <arg name="camera_info_topic" default="/aux_camera/camera_info" />
  <arg name="map_frame" default="camera_init" />
  <arg name="ground_z" default="0.0" />
  <arg name="processing_rate_hz" default="10.0" />
  <arg name="allow_latest_tf_fallback" default="false" />
  <arg name="max_latest_tf_age_sec" default="0.10" />

  <node pkg="topic_tools" type="throttle" name="aux_blue_image_throttle"
        args="messages $(arg image_topic) $(arg processing_rate_hz) /uav_vision/aux/blue_image_throttled"
        output="screen" />

  <group>
    <remap from="/uav_vision/detections"
           to="/uav_vision/aux/blue_detections" />
    <node pkg="uav_vision" type="circle_detector_node"
          name="aux_blue_ring_detector" output="screen">
      <rosparam file="$(find uav_vision)/config/circle_detector.yaml" />
      <param name="image_topic"
             value="/uav_vision/aux/blue_image_throttled" />
      <param name="camera_info_topic" value="$(arg camera_info_topic)" />
      <param name="enable_debug_image" value="false" />
      <!-- 斜视下圆环会成为椭圆；这里只做粗发现，因此放宽圆度和最小像素半径。 -->
      <param name="circle_aspect_ratio_threshold" value="0.45" />
      <param name="circle_radius_min" value="4.0" />
      <param name="circle_min_quality" value="0.45" />
      <param name="circle_duplicate_center_ratio" value="0.65" />
      <param name="circle_morphology_kernel_size" value="5" />
      <param name="circle_reject_border_clipped" value="true" />
      <param name="circle_enable_resize" value="false" />
    </node>
  </group>

  <node pkg="uav_vision_eval" type="aux_coarse_projector.py"
        name="aux_blue_coarse_projector" output="screen">
    <rosparam file="$(find uav_vision_eval)/config/oblique_camera_feasibility.yaml" />
    <param name="input_topic" value="/uav_vision/aux/blue_detections" />
    <param name="output_topic" value="/uav_vision/aux/blue_detections_mapped" />
    <param name="diagnostics_topic"
           value="/uav_vision/aux/blue_projection_diagnostics" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="projection_mode" value="mono" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="ground_z" value="$(arg ground_z)" />
    <param name="allow_latest_tf_fallback"
           value="$(arg allow_latest_tf_fallback)" />
    <param name="max_latest_tf_age_sec"
           value="$(arg max_latest_tf_age_sec)" />
  </node>

  <node pkg="uav_vision_eval" type="aux_candidate_memory.py"
        name="aux_blue_candidate_memory" output="screen">
    <rosparam file="$(find uav_vision_eval)/config/oblique_camera_feasibility.yaml" />
    <param name="input_topic"
           value="/uav_vision/aux/blue_detections_mapped" />
    <param name="output_topic" value="/uav_vision/aux/blue_targets" />
    <param name="reset_service" value="/uav_vision/aux/reset_blue_memory" />
    <param name="confirm_frames" value="2" />
    <param name="min_class_confidence" value="0.35" />
    <param name="match_distance_m" value="0.80" />
  </node>
</launch>
