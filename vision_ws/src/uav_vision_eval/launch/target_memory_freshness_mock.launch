<launch>
  <node pkg="uav_vision" type="target_memory.py" name="target_memory" output="screen">
    <rosparam file="$(find uav_vision)/config/target_memory.yaml" />
    <param name="detections_topic" value="/freshness_test/detections" />
    <param name="confirm_frames" value="2" />
    <param name="candidate_ttl" value="0.3" />
    <param name="map_memory_ttl" value="0.0" />
    <param name="selected_max_age" value="0.3" />
    <param name="require_complete_detection_sources" value="true" />
  </node>
  <node pkg="uav_vision_eval" type="target_memory_freshness_assertion.py"
        name="target_memory_freshness_assertion" output="screen" required="true" />
</launch>
