<launch>
  <!-- 固定 55° tent 场景：不启动 PX4、导航、控制或执行机构。 -->
  <arg name="world" default="$(find patrol_control)/../../../toudi4_copy.world" />
  <arg name="gui" default="false" />
  <arg name="camera_x" default="-0.124695" />
  <arg name="camera_y" default="0.581612" />
  <arg name="camera_z" default="2.0" />
  <arg name="camera_pitch_rad" default="0.959931088597" />
  <arg name="wall_timeout_sec" default="25.0" />
  <arg name="px4_root" default="$(optenv PX4_ROOT /home/xhj/PX4-Autopilot)" />
  <arg name="px4_model_root"
       default="$(arg px4_root)/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models" />

  <env name="GAZEBO_MODEL_PATH"
       value="$(find uav_vision_eval)/models:$(arg px4_model_root):$(optenv GAZEBO_MODEL_PATH)" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="false" />
    <arg name="use_sim_time" value="true" />
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="aux_blue_eval_camera_spawn"
        output="screen"
        args="-sdf -file $(find uav_vision_eval)/models/oblique_eval_camera/model.sdf
              -model oblique_blue_eval_camera
              -x $(arg camera_x) -y $(arg camera_y) -z $(arg camera_z)
              -P $(arg camera_pitch_rad) -Y 0.0" />

  <include file="$(find uav_vision_eval)/launch/ground_truth.launch">
    <arg name="catalog_file"
         value="$(find uav_vision_eval)/config/sim_target_catalog_toudi4.yaml" />
    <arg name="scenario_file"
         value="$(find uav_vision_eval)/config/scenarios/existing_targets.yaml" />
    <arg name="image_topic" value="/aux_camera/image_raw" />
    <arg name="camera_info_topic" value="/aux_camera/camera_info" />
    <arg name="camera_link_suffix" value="aux_eval_camera_link" />
    <arg name="truth_topic" value="/uav_vision_eval/aux_blue_ground_truth" />
    <arg name="world_frame" value="world" />
    <arg name="camera_pose_is_optical" value="false" />
  </include>

  <include file="$(find uav_vision_eval)/launch/oblique_aux_blue_chain.launch">
    <arg name="image_topic" value="/aux_camera/image_raw" />
    <arg name="camera_info_topic" value="/aux_camera/camera_info" />
    <arg name="map_frame" value="world" />
    <arg name="ground_z" value="0.0" />
    <arg name="allow_latest_tf_fallback" value="true" />
    <arg name="max_latest_tf_age_sec" value="5.0" />
  </include>

  <node pkg="uav_vision_eval" type="aux_blue_static_assertion.py"
        name="aux_blue_static_assertion" output="screen" required="true">
    <param name="target_catalog"
           value="$(find uav_vision_eval)/config/sim_target_catalog_toudi4.yaml" />
    <param name="topic" value="/uav_vision/aux/blue_detections_mapped" />
    <param name="wall_timeout_sec" value="$(arg wall_timeout_sec)" />
    <param name="report_path"
           value="$(optenv SIM_RUN_DIR /tmp)/gate_status.json" />
    <param name="max_map_error_m" value="0.80" />
  </node>
</launch>
