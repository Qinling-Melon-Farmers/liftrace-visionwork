<?xml version="1.0"?>
<sdf version="1.6">
  <model name="competition_overview_camera">
    <static>true</static>
    <!-- Rendering-only overhead camera, 7m above the 5.5m ceiling; near plane excludes the roof. No collision or flight inputs. -->
    <pose>0 0 0 0 0 0</pose>
    <link name="camera_link">
      <sensor name="overview" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.98</horizontal_fov>
          <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
          <clip><near>1.7</near><far>30</far></clip>
        </camera>
        <plugin name="overview_camera_controller" filename="libgazebo_ros_camera.so">
          <robotNamespace>/</robotNamespace>
          <cameraName>competition_overview</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>competition_overview_optical</frameName>
          <updateRate>10</updateRate>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
