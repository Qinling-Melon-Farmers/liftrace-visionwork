<launch>
  <node pkg="uav_vision" type="drop_aligner.py"
        name="alignment_context_optional_drop_aligner" output="screen">
    <param name="default_mode" value="drop_circle" />
    <param name="use_camera_info" value="false" />
    <param name="target_center_x" value="320.0" />
    <param name="target_center_y" value="240.0" />
    <param name="max_offset_px" value="30.0" />
    <param name="stable_frames" value="3" />
    <param name="target_max_age" value="0.5" />
    <param name="class_profile" value="r2026" />
    <param name="require_alignment_context" value="false" />
    <param name="alignment_context_topic"
           value="/alignment_optional/alignment_target_context" />
    <param name="release_evidence_context_topic"
           value="/alignment_optional/release_evidence_context" />
    <remap from="/uav_vision/targets" to="/alignment_optional/targets" />
    <remap from="/uav_vision/align_mode" to="/alignment_optional/align_mode" />
    <remap from="/uav_vision/release_evidence"
           to="/alignment_optional/release_evidence" />
  </node>

  <test test-name="alignment_context_optional" pkg="uav_vision"
        type="alignment_context_assertion.py" time-limit="15.0">
    <param name="test_mode" value="optional" />
    <param name="topic_prefix" value="/alignment_optional" />
  </test>
</launch>
