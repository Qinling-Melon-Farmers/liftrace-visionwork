<launch>
  <!-- Offline vision only: no MAVROS, planner, mission controller or actuator. -->
  <arg name="bag" />
  <arg name="output_dir" />
  <arg name="ground_z" />
  <arg name="map_frame" default="camera_init" />
  <arg name="source_camera_info_topic" default="/camera/camera_info" />
  <arg name="source_camera_topic" default="/board_trials/recording/image/compressed" />
  <param name="use_sim_time" value="true" />
  <node pkg="uav_vision" type="landing_detector_node" name="baseline" output="screen" required="true">
    <rosparam file="$(find uav_vision)/config/landing_detector.yaml" />
    <param name="image_topic" value="/replay/image" />
    <param name="camera_info_topic" value="/replay/camera_info" />
    <param name="process_only_in_landing_mode" value="false" />
    <param name="landing_adaptive_block_size" value="31" />
    <param name="landing_h_close_kernel_size" value="1" />
    <remap from="/uav_vision/detections" to="/replay/baseline" />
  </node>
  <node pkg="uav_vision" type="landing_detector_node" name="landing_detector" output="screen" required="true">
    <rosparam file="$(find uav_vision)/config/landing_detector.yaml" />
    <param name="image_topic" value="/replay/image" />
    <param name="camera_info_topic" value="/replay/camera_info" />
    <param name="process_only_in_landing_mode" value="false" />
  </node>
  <node pkg="uav_vision" type="detection_fusion.py" name="detection_fusion" output="screen" required="true">
    <rosparam file="$(find uav_vision)/config/detection_fusion.yaml" />
  </node>
  <node pkg="uav_vision" type="target_refiner.py" name="target_refiner" output="screen" required="true">
    <rosparam file="$(find uav_vision)/config/target_refiner.yaml" />
    <param name="class_profile" value="r2026" />
  </node>
  <node pkg="uav_vision" type="target_map_projector.py" name="target_map_projector" output="screen" required="true">
    <rosparam file="$(find uav_vision)/config/target_map_projector.yaml" />
    <param name="camera_info_topic" value="/replay/camera_info" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="ground_z" value="$(arg ground_z)" />
    <param name="allow_latest_tf_fallback" value="false" />
  </node>
  <node pkg="uav_vision" type="target_memory.py" name="target_memory" output="screen" required="true">
    <rosparam file="$(find uav_vision)/config/target_memory.yaml" />
    <param name="class_profile" value="r2026" />
    <param name="detections_topic" value="/uav_vision/detections_mapped" />
    <param name="require_complete_detection_sources" value="true" />
    <param name="require_map_for_candidates" value="true" />
  </node>
  <node pkg="uav_vision" type="drop_aligner.py" name="drop_aligner" output="screen" required="true">
    <rosparam file="$(find uav_vision)/config/drop_aligner.yaml" />
    <param name="class_profile" value="r2026" />
    <param name="camera_info_topic" value="/replay/camera_info" />
  </node>
  <node pkg="uav_vision" type="landing_bag_replay.py" name="landing_bag_replay" output="screen" required="true">
    <param name="bag" value="$(arg bag)" />
    <param name="output_dir" value="$(arg output_dir)" />
    <param name="source_camera_info_topic" value="$(arg source_camera_info_topic)" />
    <param name="source_camera_topic" value="$(arg source_camera_topic)" />
  </node>
</launch>
