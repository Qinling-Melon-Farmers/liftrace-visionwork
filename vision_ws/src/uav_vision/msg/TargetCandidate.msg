# 跨帧跟踪的候选目标
Header header
uint32 id
string class_name
float32 class_confidence
float32 geometry_confidence
sensor_msgs/RegionOfInterest roi
geometry_msgs/Point center_px
bool center_refined
string center_source
bool association_valid
string reject_reason
bool map_valid
geometry_msgs/Point map_point
string map_frame
float32 map_quality
float32 transform_age_sec
uint8 state
# 生命周期内累计有效观测数
uint32 observe_count
# 当前连续命中帧数；漏检一帧即清零，确认必须由该字段达到门槛
uint32 consecutive_observe_count
time first_seen
time last_seen
