<launch>
  <!-- New physical downward-camera profile. The calibration was solved on
       unrotated 1280x720 pixels; aircraft installation extrinsics remain a
       separate TF calibration. -->
  <arg name="video_devices" default="/dev/video0,/dev/video1,/dev/video2" />
  <arg name="frame_id" default="downward_camera_optical_frame" />
  <arg name="fourcc" default="MJPG" />
  <arg name="publish_rate" default="30" />
  <arg name="image_topic" default="/camera/image_raw" />
  <arg name="compressed_topic" default="/camera/image_raw/compressed" />
  <arg name="camera_info_topic" default="/camera/camera_info" />

  <node name="camera_sdk" pkg="camera_sdk" type="camera_sdk.py"
        output="screen" required="true">
    <param name="camera_param_yaml"
           value="$(find camera_sdk)/param/calibration_1280x720.yaml" />
    <param name="video_devices" value="$(arg video_devices)" />
    <param name="frame_width" value="1280" />
    <param name="frame_height" value="720" />
    <param name="fourcc" value="$(arg fourcc)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="rotation_angle" value="0" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="compressed_topic" value="$(arg compressed_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="save_images" value="false" />
    <param name="jpeg_quality" value="80" />
    <param name="max_retries" value="5" />
    <param name="retry_delay" value="0.5" />
    <param name="connection_timeout" value="3" />
  </node>
</launch>
