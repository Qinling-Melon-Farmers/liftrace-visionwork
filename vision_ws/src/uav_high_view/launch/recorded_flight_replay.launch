<launch>
  <!-- Rendering only: no PX4, MAVROS, LIO, mission manager or actuators. -->
  <arg name="source_run" />
  <arg name="presentation_recording" default="false" />
  <arg name="world" />
  <arg name="model_roots" default="$(optenv GAZEBO_MODEL_PATH)" />
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)" />
    <arg name="gui" value="false" />
    <arg name="use_sim_time" value="true" />
    <arg name="paused" value="false" />
  </include>
  <node unless="$(arg presentation_recording)" pkg="uav_vision_eval" type="camera_video_recorder.py" name="overview_video_recorder" output="screen">
    <param name="image_topic" value="/competition_overview/image_raw" />
    <param name="fps" value="10.0" />
    <param name="output_path" value="$(optenv SIM_RUN_DIR)/overview_replay.mp4" />
  </node>
  <node pkg="uav_high_view" type="recorded_flight_replay.py" name="recorded_flight_replay" output="screen" required="true">
    <param name="external_cameras" value="$(arg presentation_recording)" />
    <param name="source_run" value="$(arg source_run)" />
    <param name="model_roots" value="$(arg model_roots)" />
    <param name="vehicle_sdf" value="$(find uav_vision_eval)/models/iris_mid360_ks2a543_installed/model.sdf" />
    <param name="overview_sdf" value="$(find uav_vision_eval)/models/competition_overview_camera/model.sdf" />
    <param name="camera_z" value="7.0" />
    <!-- Skip only the 5.5m roof in this rendering camera, below-ceiling flight remains visible. -->
    <param name="camera_near" value="1.7" />
  </node>
  <include if="$(arg presentation_recording)" file="$(find uav_high_view)/launch/presentation_cameras.launch">
    <arg name="world" value="$(arg world)" />
    <arg name="vehicle_model" value="recorded_vehicle" />
  </include>
</launch>
