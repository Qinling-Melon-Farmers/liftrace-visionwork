<launch>
  <!-- Explicit research SITL entry. Must run through the repository sim_run.sh. -->
  <arg name="run_dir" default="$(env SIM_RUN_DIR)" />
  <arg name="target_model_path" />
  <arg name="field_seed" />
  <arg name="world" />
  <arg name="field_config" />
  <arg name="runtime_config" />
  <arg name="gate_geometry_config" />
  <arg name="search_initial_plan_timeout" default="0.0" />
  <arg name="coverage_config" default="$(find uav_coverage_memory)/config/shadow.yaml" />
  <arg name="local_adviser_enabled" default="false" />
  <arg name="local_motion_enabled" default="false" />
  <arg name="local_adviser_config" default="$(find uav_mission)/config/local_search_adviser.yaml" />
  <arg name="planner_probe_namespace" default="/fast_planner_node" />
  <group if="$(eval arg('local_adviser_enabled') or arg('local_motion_enabled'))">
    <param name="$(arg planner_probe_namespace)/research/local_segment_probe/enabled" value="true" />
    <include file="$(find uav_mission)/launch/local_search_adviser.launch">
      <arg name="enabled" value="true" />
      <arg name="config" value="$(arg local_adviser_config)" />
      <arg name="record_path" value="$(arg run_dir)/local_search_proposals.jsonl" />
    </include>
  </group>
  <include file="$(find uav_mission)/launch/navigation_horizontal_search_vcl06.launch">
    <arg name="target_model_path" value="$(arg target_model_path)" />
    <arg name="field_seed" value="$(arg field_seed)" />
    <arg name="world" value="$(arg world)" />
    <arg name="field_config" value="$(arg field_config)" />
    <arg name="runtime_config" value="$(arg runtime_config)" />
    <arg name="gate_geometry_config" value="$(arg gate_geometry_config)" />
    <arg name="search_initial_plan_timeout" value="$(arg search_initial_plan_timeout)" />
    <arg name="observe_full_trial" value="true" />
    <arg name="gui" value="false" />
    <arg name="rviz" value="false" />
    <arg name="record_debug" value="false" />
    <arg name="record_camera_video" value="false" />
    <arg name="record_overview_video" value="false" />
  </include>
  <include file="$(find uav_coverage_memory)/launch/shadow.launch">
    <arg name="enabled" value="true" />
    <arg name="required" value="true" />
    <arg name="config" value="$(arg coverage_config)" />
  </include>
  <param name="/research/coverage_memory/record_dir" value="$(arg run_dir)/coverage" />
  <param name="/research/coverage_memory/record_interval" value="6.0" />
  <param name="/research/coverage_memory/record_limit" value="120" />
  <rosparam file="$(find uav_mission)/config/local_motion.yaml" ns="/navigation/mission_manager/research/local_motion" />
  <param name="/navigation/mission_manager/research/local_motion/enabled" value="$(arg local_motion_enabled)" />
</launch>
